{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 -c \"import ast; ast.parse(open('start.py', encoding='utf-8').read())\")",
      "Bash(python3 -m json.tool data.json:*)",
      "Bash(make help)",
      "Bash(make check-git)",
      "Bash(make info)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(make set-git-local:*)",
      "Bash(make install-hooks:*)",
      "Bash(make setup:*)",
      "Bash(make clean:*)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  }
}
